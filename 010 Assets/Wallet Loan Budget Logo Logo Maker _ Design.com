@charset "utf-8";

.vc-alpha, .vc-alpha-checkboard-wrap { inset: 0px; position: absolute; }

.vc-alpha-checkboard-wrap { overflow: hidden; }

.vc-alpha-gradient { inset: 0px; position: absolute; }

.vc-alpha-container { cursor: pointer; height: 100%; margin: 0px 3px; position: relative; z-index: 2; }

.vc-alpha-pointer { position: absolute; z-index: 2; }

.vc-alpha-picker { background: rgb(255, 255, 255); border-radius: 1px; box-shadow: rgba(0, 0, 0, 0.6) 0px 0px 2px; cursor: pointer; height: 8px; margin-top: 1px; transform: translateX(-2px); width: 4px; }
