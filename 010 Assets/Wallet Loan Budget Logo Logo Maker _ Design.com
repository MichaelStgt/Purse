.checkbox-items[data-v-29ba7e18] .tw-rounded { border-radius: 2px; }

.resize-tool-container[data-v-4d034fcd] { border: 1px solid rgb(209, 209, 209); box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px; width: 20rem; z-index: 99999; }

.resize-popover-container[data-v-30054231] { right: 0px; top: -0.5rem; }

.dropdown-menu[data-v-8a437a3f] { align-items: flex-start; background: rgb(255, 255, 255); border: 1px solid rgb(209, 209, 209); border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.06) 0px 2px 4px, rgba(0, 0, 0, 0.1) 0px 4px 6px; display: flex; flex-direction: column; left: 0px; margin-top: 4px; min-width: 200px; padding: 8px 0px; position: absolute; right: auto; top: 100%; z-index: 50; }

.dropdown-item[data-v-8a437a3f] { align-items: center; background: transparent; border: 0px; color: rgb(61, 61, 61); cursor: pointer; display: flex; flex-direction: row; font-family: "Inter Dcom", sans-serif; font-size: 14px; font-weight: 400; gap: 8px; line-height: 20px; padding: 8px 16px; white-space: nowrap; width: 100%; }

.dropdown-item[data-v-8a437a3f]:hover { background: rgb(245, 245, 245); }

@media (min-width: 768px) {
  .dropdown-menu[data-v-8a437a3f] { left: auto; right: 0px; }
}

.border-separator { border-color: rgba(208, 208, 208, 0.5); }

.scale-logo { max-height: 1.0625rem; }

@media (min-width: 768px) {
  .scale-logo { max-height: 100% !important; }
}

.notice-class-full-center { left: calc(50% - 45vw); }

.notice-class-full-right { left: calc(50% - 70vw); }

@media screen and (min-width: 640px) and (max-width: 768px) {
  .notice-class-full-center, .notice-class-full-right { left: auto; right: 0px; }
}

.notice-class-right { left: auto; right: 0px; }
