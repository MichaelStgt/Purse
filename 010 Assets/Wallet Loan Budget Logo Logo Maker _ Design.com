.vc-header .vc-next { grid-area: 1 / next; }

.vc-header .vc-title, .vc-header .vc-prev, .vc-header .vc-next { display: flex; -webkit-box-align: center; align-items: center; border: 0px; border-radius: var(--vc-rounded); pointer-events: auto; user-select: none; cursor: pointer; }

