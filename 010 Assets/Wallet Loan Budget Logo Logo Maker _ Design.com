Content-Location: cid:css-31e340e6-657f-4b03-b996-38988ac9b082@mhtml.blink

@charset "utf-8";

.vc-editable-input { position: relative; }

.vc-input__input { border: 0px; outline: none; padding: 0px; }

.vc-input__label { text-transform: capitalize; }
------MultipartBoundary--OPqxWBFDWgnzT95GhxNnyEd9xfighEF5PgVzOc8VXn----
