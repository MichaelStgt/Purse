.vc-day-content { display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; font-size: var(--vc-text-sm); font-weight: var(--vc-font-medium); width: 28px; height: 28px; line-height: 28px; border-radius: var(--vc-rounded-full); user-select: none; cursor: pointer; }

.vc-day-content:hover { background-color: var(--vc-day-content-hover-bg); }

