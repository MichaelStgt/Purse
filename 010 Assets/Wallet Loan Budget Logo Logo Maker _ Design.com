ul.breadcrumbs li { line-height: 1.25rem; font-size: 0.75rem; vertical-align: middle; color: rgb(38, 38, 38); }

ul.breadcrumbs li:not(:last-child)::after { margin: 0px 0.625rem; content: "//"; }

.breadcrumbs__alt-bg { background-color: rgb(237, 237, 237); }

.button { padding: 1.0625rem 2.5rem; font-weight: 700; font-size: 0.875rem; line-height: 1rem; text-transform: uppercase; border: 0px; transition: 0.25s ease-out, color 0.25s ease-out; overflow: hidden; }

.button.tiny { padding: 0.5rem 1.25rem; font-size: 0.6875rem; line-height: 0.875rem; }

.button.tiny-expanded { width: 100%; }

@media print, screen and (min-width: 64em) {
  .button.tiny-expanded { width: auto; }
}

.button.small { padding: 0.75rem 1.875rem; font-size: 0.75rem; }

.button.large { padding: 1.25rem 3.125rem; font-size: 1rem; line-height: 1.25rem; }

.button.jumbo { padding: 1.5625rem 3.75rem; font-size: 1.25rem; line-height: 1.25rem; }

@media screen and (max-width: 39.9988em) {
  .button:not(.tiny) { padding-left: 0.3125rem; padding-right: 0.3125rem; width: 100%; }
  .modal__footer .button.small { padding: 0.75rem 1.875rem; width: auto; }
}

