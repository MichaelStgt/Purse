.maker-drawer { height: 100%; width: 100%; background-color: rgb(255, 255, 255); left: 0px; bottom: -100%; transition: bottom 1s; position: absolute; z-index: 99; }

.maker-drawer.is-open { bottom: 0px; }

.maker-drawer__header, .maker-drawer__footer { display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; border-top: 1px solid rgb(209, 209, 209); border-bottom: 1px solid rgb(209, 209, 209); position: relative; }

.maker-drawer__header a, .maker-drawer__footer a { position: absolute; top: 50%; right: 1rem; transform: translateY(-50%); }

.maker-drawer__body, .maker-drawer__footer { padding: 0.75rem; }

.maker-drawer__header { height: 2.5rem; background-color: rgb(227, 227, 227); }

.maker-drawer__body { height: calc(100% - 90px); overflow: hidden auto; }

.maker-drawer__body.is-loading { padding: 0px; overflow-y: hidden; }

.maker-drawer__footer { height: 3.125rem; justify-content: space-around; background-color: rgb(255, 255, 255); z-index: 2; }

.maker-drawer__footer button, .maker-drawer__footer button.expanded { margin-right: 1rem; }

.maker-drawer__footer button:last-child, .maker-drawer__footer button.expanded:last-child { margin-right: 0px; }

.maker-font-picker-select .maker-drawer__body { padding: 0px; position: relative; }

.maker-font-picker-select__button { background-color: rgb(255, 255, 255); background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' version='1.1' width='32' height='24' viewBox='0 0 32 24'><polygon points='0,0 32,0 16,24' style='fill: rgb%2889, 89, 89%29'></polygon></svg>"); background-position: right 0.9375rem center; background-repeat: no-repeat; background-size: 9px 6px; border-radius: 0.1875rem; border: 1px solid rgb(209, 209, 209); color: rgb(96, 96, 96); cursor: pointer; font-weight: 400; height: 2.9375rem; line-height: 1.75; margin-bottom: 0.9375rem; padding: 0.625rem 1.40625rem 0.625rem 0.625rem; width: 100%; text-align: left; }

.maker-font-picker-select__button-img { width: 10rem; }

.maker-font-picker-select__font-button { cursor: pointer; display: block; text-align: left; width: 100%; border-radius: 0px; padding: 0.25rem 1rem; margin-bottom: 0.5rem; }

.maker-font-picker-select__font-button:hover, .maker-font-picker-select__font-button.is-selected { background-color: rgb(63, 89, 246); }

.maker-font-picker-select__font-preview { width: 10rem; }

.maker-font-picker-select__categories { margin-top: 0.9375rem; padding: 0px 1rem; }

.maker-sidebar { width: 100%; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; }

@media print, screen and (min-width: 64em) {
  .maker-sidebar { -webkit-box-orient: horizontal; -webkit-box-direction: normal; flex-direction: row; border: 1px solid rgb(209, 209, 209); }
}

.maker-sidebar__tab-body-container { width: 100%; border: 1px solid rgb(209, 209, 209); }

@media print, screen and (min-width: 40em) {
  .maker-sidebar__tab-body-container { transform: rotate(0deg); position: relative; z-index: 1; }
}

.maker-sidebar__tab-body { -webkit-box-flex: 1; flex-grow: 1; padding: 0.75rem 0.625rem; background-color: rgb(227, 227, 227); }

@media print, screen and (min-width: 40em) {
  .maker-sidebar__tab-body { padding: 1.5rem 1.125rem 0px; }
}

.maker-sidebar__tab-body-header { display: flex; -webkit-box-orient: horizontal; -webkit-box-direction: normal; flex-direction: row; -webkit-box-pack: justify; justify-content: space-between; padding-bottom: 0.875rem; margin-bottom: 0.875rem; color: rgb(23, 23, 23); font-size: 1.25rem; font-weight: 700; border-bottom: 0.125rem solid rgb(216, 216, 216); }

.is-admin .maker-sidebar__tab-body-header { font-size: 1rem; border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; padding-bottom: 0px; margin: 0.625rem 0px; }

.maker-sidebar__tab-body input, .maker-sidebar__tab-body .v-select.dropdown .dropdown-toggle { margin-bottom: 0.6875rem; }

.maker-sidebar__tab-body p { font-size: 0.75rem; }

.maker-sidebar__close-button { display: inline-flex; height: 1.75rem; width: 1.75rem; background-color: rgb(227, 227, 227); position: fixed; right: 2px; top: 2px; z-index: 1; padding: 0.375rem; }

.maker-sidebar__relative-container { position: relative; }

.maker-sidebar__relative-container:hover .maker-sidebar__overlay-hover { display: block; }

.maker-sidebar__relative-container:hover .maker-sidebar__overlay-hover-text { display: block; }

.maker-sidebar__overlay, .maker-sidebar__overlay-hover { height: 100%; width: 100%; cursor: pointer; position: absolute; top: 0px; left: 0px; }

.maker-sidebar__overlay { display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; color: rgb(255, 255, 255); background-color: rgba(23, 23, 23, 0.66); }

.maker-sidebar__overlay-hover { display: none; background-color: rgba(23, 23, 23, 0.33); }

.maker-sidebar__overlay-hover-text { display: none; color: rgb(255, 255, 255); position: absolute; left: 0.6875rem; bottom: 0.6875rem; z-index: 1; }

.maker-sidebar__overlay-hover-text a { color: rgb(255, 255, 255); }

.maker-sidebar__overlay-hover-text a:hover, .maker-sidebar__overlay-hover-text a:active, .maker-sidebar__overlay-hover-text a:visited { color: rgb(255, 255, 255); }

.maker-sidebar__overlay-hover-text a:hover { text-decoration: underline; }

@media print, screen and (min-width: 64em) {
  .maker-fit-mode .maker-rhs-container { max-width: 500px; min-width: 500px; }
  .maker-fit-mode .maker-sidebar__tab-body-container { background-color: rgb(227, 227, 227); }
}

.maker-fit-mode .maker-rhs-container { width: 100%; }

.maker-fit-mode .maker-rhs-container .maker-sidebar, .maker-fit-mode .maker-rhs-container .maker-sidebar__tab-body { height: 100%; }

.maker-spinner-container { position: relative; }

.maker-spinner-container--max-height { max-height: 100%; }

.maker-spinner { display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; background-color: rgba(237, 237, 237, 0.8); position: absolute; inset: 0px; z-index: 5; }

.maker-spinner__icon { height: 1.875rem; width: 1.875rem; background-image: url("../images/icons/modals/modals-loading-170a646f7f.svg"); background-position: center center; background-repeat: no-repeat; animation: 1s linear 0s infinite normal none running spin-cw-1turn; }

.maker-fit-mode > .maker-spinner { width: 100vw; height: 100vh; }

.maker-text-input-overlay { position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.8); z-index: 999; }

.maker-text-input-overlay__content { background: rgb(255, 255, 255); padding: 0.625rem; }

input.maker-input--faked { background: rgb(255, 255, 255); }

.maker-toolbar { display: flex; margin-bottom: 1.125rem; }

.maker-toolbar .maker-toolbar .maker-tool:last-child { margin-right: 0.9375rem; }

.maker-toolbar .maker-tool { margin-right: 0.9375rem; }

.maker-toolbar .maker-tool:last-child { margin-right: 0px; }

.maker-sidebar .maker-toolbar .maker-tool { margin-right: 0.75rem; }

.maker-sidebar .maker-toolbar--font-options { margin-bottom: 0px; }

.maker-tool { height: 2rem; display: inline-flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-pack: end; justify-content: flex-end; -webkit-box-align: center; align-items: center; color: rgb(96, 96, 96); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }

.maker-tool:active, .maker-tool:hover { cursor: pointer; }

.is-disabled .maker-tool, .maker-tool.is-disabled, .maker-tool.disabled, .maker-tool[disabled] { opacity: 0.5; cursor: not-allowed; }

.maker-tool.is-checked { background-color: rgb(209, 209, 209); }

.maker-tool.maker-tool--compact[class*="maker-tool--"] { height: auto; -webkit-box-pack: center; justify-content: center; padding: 0.5em 0.5em 0.2em 0.2em; text-indent: 2.5em; background-position: left center; }

.maker-tool--box, .input-group .maker-tool--box { height: 3.125rem; width: 3.125rem; -webkit-box-pack: center; justify-content: center; border: 1px solid rgb(209, 209, 209); background-color: rgb(255, 255, 255); }

.maker-tool--box.is-selected, .input-group .maker-tool--box.is-selected { border: 2px solid rgb(63, 89, 246); }

.maker-tool--plus, .maker-tool--minus { -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; position: relative; display: flex !important; }

.maker-tool--plus::after, .maker-tool--minus::after { color: rgb(38, 38, 38); display: block; font-size: 1.5625rem; font-weight: 400; left: 0px; right: 0px; }

.maker-tool--plus::after { content: "+"; }

.maker-tool--minus::after { content: "−"; }

.maker-tool--align-center { background-image: url("../images/maker/toolbar/toolbar-align-center-c24db04065.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--align-left { background-image: url("../images/maker/toolbar/toolbar-align-left-b6c73b807e.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--align-right { background-image: url("../images/maker/toolbar/toolbar-align-right-ce0d4ccb13.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--align-justify { background-image: url("../images/maker/toolbar/toolbar-align-justify-5dfdbc7a39.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--bold { background-image: url("../images/maker/toolbar/toolbar-bold-96c9a00988.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--italic { background-image: url("../images/maker/toolbar/toolbar-italic-ec6af1215b.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--underline { background-image: url("../images/maker/toolbar/toolbar-underline-36415da2cd.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--layout-top { background-image: url("../images/maker/toolbar/toolbar-layout-top-57e3aaed85.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--layout-right { background-image: url("../images/maker/toolbar/toolbar-layout-right-f59021e914.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--layout-bottom { background-image: url("../images/maker/toolbar/toolbar-layout-bottom-2c18ce5e66.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--layout-left { background-image: url("../images/maker/toolbar/toolbar-layout-left-5bf563584b.svg"); background-repeat: no-repeat; background-position: center center; }

.maker-tool--add-text { background-image: url("../images/maker/toolbar/toolbar-add-text-253f614390.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--add-background { background-image: url("../images/maker/toolbar/toolbar-add-background-2d5e249a2f.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--add-shape { background-image: url("../images/maker/toolbar/toolbar-add-shape-2502adaf0b.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--delete { background-image: url("../images/maker/toolbar/toolbar-delete-f43c96710c.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--duplicate { background-image: url("../images/maker/toolbar/toolbar-duplicate-cc517ff3fd.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--undo { background-image: url("../images/maker/toolbar/toolbar-undo-ed8470395d.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--redo { background-image: url("../images/maker/toolbar/toolbar-redo-8152e07ddd.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--reset { background-image: url("../images/maker/toolbar/toolbar-reset-18449086c1.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--layer { background-image: url("../images/maker/toolbar/toolbar-layer-f13f6ae29b.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--layer-bring-front { background-image: url("../images/maker/toolbar/toolbar-layer-bring-front-116c099bef.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--layer-send-back { background-image: url("../images/maker/toolbar/toolbar-layer-send-back-4dd168eb3f.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--opacity { background-image: url("../images/maker/toolbar/toolbar-opacity-15ffdf64aa.svg"); background-repeat: no-repeat; background-position: center top; }

.maker-tool--filters { background-image: url("../images/maker/toolbar/toolbar-filters-d91f091549.svg"); background-repeat: no-repeat; background-position: center top; }

.input-group--stepper .input-group-button:first-child .maker-tool { border-right-width: medium; border-right-style: none; border-right-color: currentcolor; border-top-right-radius: 0px; border-bottom-right-radius: 0px; }

.input-group--stepper .input-group-button:last-child .maker-tool { border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-top-left-radius: 0px; border-bottom-left-radius: 0px; }

.maker-context-menu .maker-tool { color: rgb(38, 38, 38); font-size: 0.875rem; font-weight: 400; text-transform: none; background-size: 1rem; }

.maker-context-menu .maker-tool.maker-tool--compact { text-indent: 1rem; }

.maker-context-menu .maker-tool.maker-tool--delete { background-size: 0.75rem; }

.maker-fit-mode .maker-toolbar { padding: 0.375rem 0px; margin-bottom: 0px; }

.maker-fit-mode .maker-toolbar--topbar { padding: 0.375rem 3.4375rem; }

.maker-fit-mode .maker-toolbar .maker-tool { margin: 0px 0.5rem; }

.maker-fit-mode .maker-toolbar .maker-tool.maker-tool--compact[class*="maker-tool--"] { height: unset; }

.maker-fit-mode .maker-toolbar-container { height: 2.875rem; width: 100%; }

.maker-tool-spacer { -webkit-box-flex: 0; flex-grow: 0; }

@media print, screen and (min-width: 40em) {
  .maker-tool-spacer { -webkit-box-flex: 1; flex-grow: 1; }
}

.logo-edit-settings--icon-btn { height: 100%; width: 100%; cursor: pointer; background-position: center center; }

.v-select.dropdown button.clear { display: none; }

.v-select.dropdown .dropdown-toggle { height: 2.9375rem; margin: 0px 0px 0.9375rem; padding: 0.625rem 1.40625rem 0.625rem 0.625rem; appearance: none; border: 1px solid rgb(209, 209, 209); border-radius: 0px; background-color: rgb(255, 255, 255); font-family: inherit; font-size: 1rem; font-weight: 400; line-height: 1.75; color: rgb(96, 96, 96); background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' version='1.1' width='32' height='24' viewBox='0 0 32 24'><polygon points='0,0 32,0 16,24' style='fill: rgb%2896, 96, 96%29'></polygon></svg>"); background-origin: content-box; background-position: right -0.9375rem center; background-repeat: no-repeat; background-size: 9px 6px; transition: box-shadow 0.5s, border-color 0.25s ease-in-out, -webkit-box-shadow 0.5s; }

@media screen and (min-width:0\0) {
  .v-select.dropdown .dropdown-toggle { background-image: url("data:image/png;base64,"); }
}

.v-select.dropdown .dropdown-toggle:focus { outline: 0px; border: 1px solid rgb(96, 96, 96); background-color: rgb(255, 255, 255); box-shadow: rgb(209, 209, 209) 0px 0px 5px; transition: box-shadow 0.5s, border-color 0.25s ease-in-out, -webkit-box-shadow 0.5s; }

.v-select.dropdown .dropdown-toggle:disabled { background-color: rgb(237, 237, 237); cursor: not-allowed; }

.v-select.dropdown .dropdown-toggle[multiple] { height: auto; background-image: none; }

.v-select.dropdown .dropdown-toggle .selected-tag, .v-select.dropdown .dropdown-toggle .form-control { position: absolute; top: 50%; transform: translateY(-50%); }

.v-select.dropdown .dropdown-toggle .selected-tag { padding: 0px; margin: 0px; color: rgb(96, 96, 96); }

.v-select.dropdown .dropdown-toggle .form-control { padding: 0px; left: 0.75rem; width: 100% !important; }

.v-select.dropdown .dropdown-toggle .open-indicator { display: none; }

.v-select.dropdown .dropdown-menu { max-height: 20.3125rem !important; }

.maker-font-dropdown.is-loading .v-select.dropdown { transform: rotate(0deg); z-index: 1; }

.maker-font-dropdown.is-loading .v-select.dropdown .dropdown-menu::before { height: 23.4375rem; content: ""; background-color: rgba(237, 237, 237, 0.8); top: 0px; right: 0px; left: 0px; position: fixed; }

.maker-font-dropdown.is-loading .v-select.dropdown .dropdown-menu::after { height: 1.875rem; width: 1.875rem; content: ""; margin: 0px auto; background-image: url("../images/icons/modals/modals-loading-170a646f7f.svg"); background-position: center center; background-repeat: no-repeat; animation: 1s linear 0s infinite normal none running spin-cw-1turn; position: fixed; inset: 10.125rem 0px 0px; }

.image-filter-list { display: flex; width: 260px; flex-wrap: wrap; margin-right: -12px; margin-bottom: -12px; }

.image-filter-picker { display: inline-block; margin: 0px 10px 10px 0px; cursor: pointer; overflow: hidden; border: 3px solid transparent; }

.image-filter-picker.is-none { border: 3px solid gray; border-radius: 8px; }

.image-filter-picker.is-selected { border: 3px solid rgb(0, 151, 215); border-radius: 8px; }

.image-filter-picker__figure { height: 48px; width: 48px; }

.image-filter-picker__none-filer, .image-filter-picker-preview-image { height: 100%; width: 100%; object-fit: cover; z-index: 0; border-radius: 6px; }

.image-filter-picker__none-filer.is-selected, .image-filter-picker-preview-image.is-selected { border-radius: 0px; }

.image-filter-picker__none-filer { background-color: rgb(255, 255, 255); text-align: center; vertical-align: middle; line-height: 48px; padding: 0px; font-size: 12px; }

.slick-slider { position: relative; display: block; box-sizing: border-box; user-select: none; touch-action: pan-y; -webkit-tap-highlight-color: transparent; }

.slick-list { position: relative; overflow: hidden; display: block; margin: 0px; padding: 0px; }

.slick-list:focus { outline: 0px; }

.slick-list.dragging { cursor: pointer; }

.slick-slider .slick-track, .slick-slider .slick-list { transform: translate3d(0px, 0px, 0px); }

.slick-track { position: relative; left: 0px; top: 0px; display: block; margin-left: auto; margin-right: auto; }

.slick-track::before, .slick-track::after { content: ""; display: table; }

.slick-track::after { clear: both; }

.slick-loading .slick-track { visibility: hidden; }

.slick-slide { float: left; height: 100%; min-height: 1px; display: none; }

[dir="rtl"] .slick-slide { float: right; }

.slick-slide img { display: block; }

.slick-slide.slick-loading img { display: none; }

.slick-slide.dragging img { pointer-events: none; }

.slick-initialized .slick-slide { display: block; }

.slick-loading .slick-slide { visibility: hidden; }

.slick-vertical .slick-slide { display: block; height: auto; border: 1px solid transparent; }

.slick-arrow.slick-hidden { display: none; }
