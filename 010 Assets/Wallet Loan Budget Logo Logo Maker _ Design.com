.locale-switcher-select[data-v-8809b8de] { appearance: none; background-repeat: no-repeat; border-width: 1px; cursor: pointer; height: 3rem; max-width: 100%; padding: 0.75rem 1.5rem 0.75rem 0.75rem; width: 100%; }

.locale-switcher-select[data-v-8809b8de]::placeholder { --tw-placeholder-opacity: 1; color: rgb(94 94 94/var(--tw-placeholder-opacity)); }

.locale-switcher-select[data-v-8809b8de] { --tw-shadow: inset 0 2px 4px 0 rgba(0,0,0,.05); --tw-shadow-colored: inset 0 2px 4px 0 var(--tw-shadow-color); transition-duration: 0.3s; transition-property: color, background-color, border-color, text-decoration-color, fill, stroke; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }

.locale-switcher-select[data-v-8809b8de], .locale-switcher-select[data-v-8809b8de]:focus { box-shadow: var(--tw-ring-offset-shadow,0 0 #0000),var(--tw-ring-shadow,0 0 #0000),var(--tw-shadow); }

.locale-switcher-select[data-v-8809b8de]:focus { --tw-border-opacity: 1; border-color: rgb(89 89 89/var(--tw-border-opacity)); --tw-shadow: 0 1px 2px 0 rgba(0,0,0,.05); --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color); outline: transparent solid 2px; outline-offset: 2px; }

.locale-switcher-select[data-v-8809b8de] { background-origin: content-box; background-position: right -0.9375rem center; background-repeat: no-repeat; background-size: 9px 6px; }

.locale-switcher-select[data-v-8809b8de]:disabled { cursor: not-allowed; opacity: 0.5; }

.locale-switcher-dark[data-v-8809b8de] { background-color: rgb(0 0 0/var(--tw-bg-opacity)); background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' version='1.1' width='32' height='24' viewBox='0 0 32 24'><polygon points='0,0 32,0 16,24' style='fill: white'></polygon></svg>"); border-color: rgb(239 239 239/var(--tw-border-opacity)); color: rgb(255 255 255/var(--tw-text-opacity)); }

.locale-switcher-dark[data-v-8809b8de], .locale-switcher-light[data-v-8809b8de] { --tw-border-opacity: 1; --tw-bg-opacity: 1; --tw-text-opacity: 1; }

.locale-switcher-light[data-v-8809b8de] { background-color: rgb(255 255 255/var(--tw-bg-opacity)); background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' version='1.1' width='32' height='24' viewBox='0 0 32 24'><polygon points='0,0 32,0 16,24' style='fill: rgb%2889, 89, 89%29'></polygon></svg>"); border-color: rgb(208 208 208/var(--tw-border-opacity)); border-radius: 0.25rem; color: rgb(0 0 0/var(--tw-text-opacity)); }

.error-boundary-fallback[data-v-86ddeac0] { align-items: flex-start; background-color: rgb(237, 237, 237); box-sizing: border-box; color: rgb(38, 38, 38); display: flex; font-family: Montserrat, Helvetica, Arial, sans-serif; justify-content: center; line-height: 1.75; min-height: 100vh; padding: 48px 10px; -webkit-font-smoothing: antialiased; }

.error-card[data-v-86ddeac0] { background: rgb(255, 255, 255); max-width: 1180px; padding: 1.875rem; width: 100%; }

#error-title[data-v-86ddeac0] { font-size: 3rem; font-weight: 700; }

#error-subtitle[data-v-86ddeac0] { font-size: 1.5rem; font-weight: 400; margin: 0px 0px 1rem; }

#error-body[data-v-86ddeac0] { font-size: 1rem; font-weight: 400; }
