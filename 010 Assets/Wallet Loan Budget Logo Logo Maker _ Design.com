@charset "utf-8";

.vc-sketch { background: rgb(255, 255, 255); border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.15) 0px 0px 0px 1px, rgba(0, 0, 0, 0.15) 0px 8px 16px; box-sizing: initial; padding: 10px 10px 0px; position: relative; width: 200px; }

.vc-sketch-saturation-wrap { overflow: hidden; padding-bottom: 75%; position: relative; width: 100%; }

.vc-sketch-controls { display: flex; }

.vc-sketch-sliders { flex: 1 1 0%; padding: 4px 0px; }

.vc-sketch-sliders .vc-alpha-gradient, .vc-sketch-sliders .vc-hue { border-radius: 2px; }

.vc-sketch-alpha-wrap, .vc-sketch-hue-wrap { height: 10px; position: relative; }

.vc-sketch-alpha-wrap { margin-top: 4px; overflow: hidden; }

.vc-sketch-color-wrap { border-radius: 3px; height: 24px; margin-left: 4px; margin-top: 4px; position: relative; width: 24px; }

.vc-sketch-active-color { border-radius: 2px; inset: 0px; box-shadow: rgba(0, 0, 0, 0.15) 0px 0px 0px 1px inset, rgba(0, 0, 0, 0.25) 0px 0px 4px inset; position: absolute; z-index: 2; }

.vc-sketch-color-wrap .vc-checkerboard { background-size: auto; }

.vc-sketch-field { display: flex; padding-top: 4px; }

.vc-sketch-field .vc-input__input { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; box-shadow: rgb(204, 204, 204) 0px 0px 0px 1px inset; font-size: 10px; padding: 4px 0px 3px 10%; width: 90%; }

.vc-sketch-field .vc-input__label { color: rgb(34, 34, 34); display: block; font-size: 11px; padding-bottom: 4px; padding-top: 3px; text-align: center; text-transform: capitalize; }

.vc-sketch-field--single { flex: 1 1 0%; padding-left: 6px; }

.vc-sketch-field--double { flex: 2 1 0%; }

.vc-sketch-presets { border-top: 1px solid rgb(238, 238, 238); margin-left: -10px; margin-right: -10px; padding-left: 10px; padding-top: 10px; }

.vc-sketch-presets-color { cursor: pointer; display: inline-block; height: 16px; margin: 0px 10px 10px 0px; overflow: hidden; position: relative; vertical-align: top; width: 16px; }

.vc-sketch-presets-color, .vc-sketch-presets-color .vc-checkerboard { border-radius: 3px; box-shadow: rgba(0, 0, 0, 0.15) 0px 0px 0px 1px inset; }

.vc-sketch__disable-alpha .vc-sketch-color-wrap { height: 10px; }
------MultipartBoundary--OPqxWBFDWgnzT95GhxNnyEd9xfighEF5PgVzOc8VXn----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-5064a40f-9db8-4ff5-83fd-5cacde6dace5@mhtml.blink

@charset "utf-8";

.vc-hue { border-radius: 2px; inset: 0px; position: absolute; }

.vc-hue--horizontal { background: linear-gradient(90deg, red 0px, rgb(255, 255, 0) 17%, rgb(0, 255, 0) 33%, rgb(0, 255, 255) 50%, rgb(0, 0, 255) 67%, rgb(255, 0, 255) 83%, red); }

.vc-hue--vertical { background: linear-gradient(0deg, red 0px, rgb(255, 255, 0) 17%, rgb(0, 255, 0) 33%, rgb(0, 255, 255) 50%, rgb(0, 0, 255) 67%, rgb(255, 0, 255) 83%, red); }

.vc-hue-container { cursor: pointer; height: 100%; margin: 0px 2px; position: relative; }

.vc-hue-pointer { position: absolute; z-index: 2; }

.vc-hue-picker { background: rgb(255, 255, 255); border-radius: 1px; box-shadow: rgba(0, 0, 0, 0.6) 0px 0px 2px; cursor: pointer; height: 8px; margin-top: 1px; transform: translateX(-2px); width: 4px; }
------MultipartBoundary--OPqxWBFDWgnzT95GhxNnyEd9xfighEF5PgVzOc8VXn----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-4be0b136-9222-4167-bba5-b82781bcf507@mhtml.blink

@charset "utf-8";

.vc-saturation, .vc-saturation--black, .vc-saturation--white { inset: 0px; cursor: pointer; position: absolute; }

.vc-saturation--white { background: linear-gradient(90deg, rgb(255, 255, 255), rgba(255, 255, 255, 0)); }

.vc-saturation--black { background: linear-gradient(0deg, rgb(0, 0, 0), transparent); }

.vc-saturation-pointer { cursor: pointer; position: absolute; }

.vc-saturation-circle { border-radius: 50%; box-shadow: rgb(255, 255, 255) 0px 0px 0px 1.5px, rgba(0, 0, 0, 0.3) 0px 0px 1px 1px inset, rgba(0, 0, 0, 0.4) 0px 0px 1px 2px; height: 4px; transform: translate(-2px, -2px); width: 4px; }
------MultipartBoundary--OPqxWBFDWgnzT95GhxNnyEd9xfighEF5PgVzOc8VXn----
Content-Type: text/css
