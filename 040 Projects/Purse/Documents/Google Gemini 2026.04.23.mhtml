n-node=3D"85">Title</code> and <code data-path-to-node=3D"3,0,0" data-index=
-in-node=3D"95">Description</code> via <code data-path-to-node=3D"3,0,0" da=
ta-index-in-node=3D"111">BindableObject</code>).</p></li><li><p data-path-t=
o-node=3D"3,1,0"><b data-path-to-node=3D"3,1,0" data-index-in-node=3D"0">Si=
ngular Namespaces:</b> <code data-path-to-node=3D"3,1,0" data-index-in-node=
=3D"21">Purse.Model</code>, <code data-path-to-node=3D"3,1,0" data-index-in=
-node=3D"34">Purse.View</code>, <code data-path-to-node=3D"3,1,0" data-inde=
x-in-node=3D"46">Purse.ViewModel</code>.</p></li><li><p data-path-to-node=
=3D"3,2,0"><b data-path-to-node=3D"3,2,0" data-index-in-node=3D"0">Collecti=
on Views:</b> <code data-path-to-node=3D"3,2,0" data-index-in-node=3D"18">[=
ModelName][Meaning]CollectionView</code> &amp; <code data-path-to-node=3D"3=
,2,0" data-index-in-node=3D"55">[ModelName][Meaning]CollectionViewModel</co=
de> (e.g., <code data-path-to-node=3D"3,2,0" data-index-in-node=3D"102">Tra=
nsactionHistoryCollectionView</code> / <code data-path-to-node=3D"3,2,0" da=
ta-index-in-node=3D"137">TransactionHistoryCollectionViewModel</code>).</p>=
</li><li><p data-path-to-node=3D"3,3,0"><b data-path-to-node=3D"3,3,0" data=
