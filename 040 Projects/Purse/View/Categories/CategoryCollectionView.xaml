<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Purse.View.CategoryCollectionView"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Purse.Shared.Model;assembly=Purse.Shared"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="CategoryCollectionViewModel">

    <Shell.TitleView>
        <Label
            Style="{x:StaticResource ShellTitleView}"
            Text="{x:Binding Title}"
            ToolTipProperties.Text="{x:Static AccessibiltyResources.CategoryCollectionTitleViewTooltip}" />
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{x:Binding AddItemCommand}"
            IconImageSource="{x:StaticResource AddIcon}"
            Text="{x:Static AppResources.AddCategory}" />
    </ContentPage.ToolbarItems>

