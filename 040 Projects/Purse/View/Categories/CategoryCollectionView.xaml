            ToggledTextColor="{x:AppThemeBinding Light={x:StaticResource OffWhite},
                                                 Dark={x:StaticResource OffWhite}}"
                       <ChipSwitch.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </ChipSwitch.StrokeShape>
            -->

