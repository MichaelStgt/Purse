        <!--  Single RefreshView & CollectionView  -->
        <RefreshView
            Grid.Row="2"
            Command="{x:Binding LoadItemCollectionCommand}"
            IsRefreshing="{x:Binding IsBusy,
                                     Mode=OneWay}">

            <CollectionView
                ItemsSource="{x:Binding FilteredCategories}"
                SelectedItem="{x:Binding SelectedItem}"
                SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        ItemSpacing="4"
                        Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <Border Style="{x:StaticResource CollectionViewItemBorder}">
                            <!--
                                Margin="{x:StaticResource DefaultElementMargin}"
                                Padding="{x:StaticResource DefaultPadding}"
                                Stroke="{x:StaticResource Primary}"
                            -->
                            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                <Label
                                    Grid.Column="0"
                                    FontFamily="{x:Static FontDefinitions.DefaultMediumFontFamily}"
                                    FontSize="{x:StaticResource MediumFontSize}"
                                    Text="{x:Binding DisplayName}"
                                    VerticalOptions="Center" />

                                <!--  Badges  -->
                                <Border
                                    x:Name="DefaultBadge"
                                    Grid.Column="1"
                                    Margin="4,0,4,0"
                                    Padding="8,2"
                                    IsVisible="{x:Binding IsDefault}"
                                    StrokeThickness="1">
                                    <Label
                                        FontSize="{x:StaticResource SmallFontSize}"
                                        Text="{x:Static AppResources.Default}"
                                        TextColor="{x:AppThemeBinding Light={x:DynamicResource OffWhite},
                                                                      Dark={x:DynamicResource OffWhite}}" />

                                </Border>
                                <Border
                                    x:Name="SystemBadge"
                                    Grid.Column="2"
                                    Margin="4,0,4,0"
                                    Padding="8,2"
                                    IsVisible="{x:Binding IsSystem}"
                                    StrokeThickness="1">

                                    <Label
                                        FontSize="{x:StaticResource SmallFontSize}"
                                        Text="System"
                                        TextColor="{x:AppThemeBinding Light={x:DynamicResource Primary},
                                                                      Dark={x:DynamicResource OffWhite}}" />
                                </Border>
                                <ImageButton
                                    Grid.Row="0"
                                    Grid.RowSpan="1"
                                    Grid.Column="3">
                                    <ImageButton.Source>
                                        <FontImageSource
                                            FontFamily="{x:Static FontDefinitions.MaterialSymbolsOutlinedFontFamily}"
                                            Glyph="{x:Static MaterialSymbols.Chevron_right}"
                                            Size="24"
                                            Color="Gray" />
                                    </ImageButton.Source>
                                </ImageButton>

                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{x:AppThemeBinding Light=Transparent, Dark=Transparent}" />
                                            <Setter TargetName="DefaultBadge" Property="Border.BackgroundColor" Value="{x:AppThemeBinding Light={x:DynamicResource Primary}, Dark={x:DynamicResource Primary}}" />
                                            <Setter TargetName="SystemBadge" Property="Border.Stroke" Value="{x:AppThemeBinding Light={x:DynamicResource OffBlack}, Dark={x:DynamicResource Primary}}" />
                                            <Setter TargetName="DefaultBadge" Property="Border.Stroke" Value="{x:AppThemeBinding Light={x:DynamicResource Primary}, Dark={x:DynamicResource Primary}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{x:AppThemeBinding Light={x:DynamicResource Gray100}, Dark={x:DynamicResource Primary}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{x:AppThemeBinding Light={x:DynamicResource Gray100}, Dark={x:DynamicResource Primary}}" />
                                            <Setter TargetName="SystemBadge" Property="Border.Stroke" Value="{x:AppThemeBinding Light={x:DynamicResource Primary}, Dark={x:DynamicResource OffBlack}}" />
                                            <Setter TargetName="DefaultBadge" Property="Border.Stroke" Value="{x:AppThemeBinding Light={x:DynamicResource Primary}, Dark={x:DynamicResource OffBlack}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
