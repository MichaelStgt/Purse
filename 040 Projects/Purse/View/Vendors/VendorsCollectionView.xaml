<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Purse.View.VendorsCollectionView"
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Purse.Shared.Model;assembly=Purse.Shared"
    xmlns:viewmodels="clr-namespace:Purse.ViewModel"
    x:DataType="viewmodels:VendorsCollectionViewModel">

    <Shell.TitleView>
        <Label
            Style="{x:StaticResource ShellTitleView}"
            Text="{x:Binding Title}" />
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{x:Binding AddVendorCommand}"
            IconImageSource="{x:StaticResource AddIcon}"
            Text="{x:Static AppResources.AddVendor}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*">
        <RefreshView
            Grid.Row="0"
            Command="{x:Binding LoadItemCollectionCommand}"
            IsRefreshing="{x:Binding IsBusy,
                                     Mode=OneWay}">

            <CollectionView
                ItemsSource="{x:Binding ItemCollection}"
                SelectedItem="{x:Binding SelectedItem}"
                SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        ItemSpacing="4"
                        Orientation="Vertical" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label
                            Margin="0,0,0,16"
                            HorizontalOptions="Center"
                            Text="{x:Static AppResources.NoVendorsFound}"
                            TextColor="{x:AppThemeBinding Light={x:StaticResource Gray500}, Dark={x:StaticResource Gray400}}" />
                        <Button
                            Command="{x:Binding BindingContext.AddVendorCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            HorizontalOptions="Center"
                            Text="{x:Static AppResources.AddNewVendor}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Vendor">
                        <Border Style="{x:StaticResource CollectionViewItemBorder}">
                            <Grid
                                ColumnDefinitions="*, Auto"
                                RowDefinitions="Auto, Auto">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontFamily="{x:Static FontDefinitions.DefaultMediumFontFamily}"
                                    FontSize="{x:StaticResource MediumFontSize}"
                                    Text="{x:Binding Name}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontSize="{x:StaticResource SmallFontSize}"
                                    IsVisible="{x:Binding Description,
                                                          Converter={StaticResource StringNotNullOrEmptyToBoolConverter}}"
                                    Text="{x:Binding Description}"
                                    TextColor="Gray" />
                                <ImageButton
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="1">
                                    <ImageButton.Source>
                                        <FontImageSource
                                            FontFamily="{x:Static FontDefinitions.MaterialSymbolsOutlinedFontFamily}"
                                            Glyph="{x:Static MaterialSymbols.Chevron_right}"
                                            Size="24"
                                            Color="Gray" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{x:AppThemeBinding Light=Transparent, Dark=Transparent}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{x:AppThemeBinding Light={x:DynamicResource Gray100}, Dark={x:DynamicResource Primary}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{x:AppThemeBinding Light={x:DynamicResource Gray100}, Dark={x:DynamicResource Primary}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
