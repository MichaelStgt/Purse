        <Setter Property="Stroke" Value="{x:AppThemeBinding Light={x:StaticResource Gray200}, Dark={x:StaticResource Primary}}" />
        <!--<Setter Property="StrokeShape" Value="RoundRectangle 16,16,16,16" />-->
        <Setter Property="StrokeThickness" Value="{x:OnPlatform WinUI='0.25', Default='2'}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="4" />
        </Setter>
