            <RoundRectangle CornerRadius="4" />
        </Setter>
        <Setter Property="TextColor" Value="{x:AppThemeBinding Light={x:StaticResource OffBlack}, Dark={x:StaticResource OffWhite}}" />
        <Setter Property="ToggleColor" Value="{x:AppThemeBinding Light={x:DynamicResource Primary}, Dark={x:DynamicResource Primary}}" />
        <Setter Property="ToggledTextColor" Value="{x:AppThemeBinding Light={x:StaticResource OffWhite}, Dark={x:StaticResource OffWhite}}" />
